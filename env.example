# Copie para .env e preencha com os dados do seu projeto Supabase.
# Como o site é HTML/CSS/JS puro (sem build), o navegador não lê o .env
# diretamente — quem alimenta o app é o config.js (veja config.example.js).
# Este .env fica aqui como referência única das credenciais do projeto,
# útil se um script Node (seed, migração etc.) for adicionado depois.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Chave do Google Gemini (chat de IA). Referência apenas — em runtime o
# chat.js lê essa chave da tabela app_settings do Supabase (cadastre pela
# aba Admin → "Configurações"). Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_DO_GEMINI
